# Environment variables for WasteChain deployment

# Application
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://your-domain.com

# Port (for self-hosted deployments)
PORT=3000

# Data Directory (optional - defaults to ./data)
# DATA_DIR=/var/www/wastechain/data

# Blockchain Configuration (optional)
# BLOCKCHAIN_DATA_DIR=/var/www/wastechain/blockchain
# BLOCKCHAIN_ENABLED=true

# IoT Simulation
# IOT_UPDATE_INTERVAL=30000

# Session/Auth (for production, use proper JWT)
# JWT_SECRET=your-secret-key-here
# SESSION_SECRET=your-session-secret-here

# For Vercel/Netlify deployments, no additional env vars needed
